# Strong4Life Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
# For local development, these match docker-compose.yml defaults
DATABASE_URL=ecto://postgres:postgres@localhost/strong4life_dev

# For production (used in docker-compose.prod.yml)
DB_PASSWORD=your-secure-postgres-password

# ===========================================
# Phoenix Configuration
# ===========================================
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=your-secret-key-base-here

# The hostname for your app (used for URL generation)
PHX_HOST=localhost

# Port the app listens on (default: 4000)
PORT=4000

# ===========================================
# SMTP Configuration (for email)
# ===========================================
SMTP_HOST=your-smtp-server.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# Docker Hub Configuration (for CI/CD)
# ===========================================
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest
