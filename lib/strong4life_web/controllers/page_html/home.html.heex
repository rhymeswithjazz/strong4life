<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
  <!-- Hero Section -->
  <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center">
      <!-- Logo / Icon -->
      <div class="mb-8 flex justify-center">
        <div class="w-20 h-20 bg-emerald-500 rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-500/30">
          <svg class="w-12 h-12 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
      </div>

      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 tracking-tight">
        Strong<span class="text-emerald-400">4</span>Life
      </h1>
      
      <p class="text-xl text-slate-400 mb-8 max-w-2xl mx-auto">
        A simple, focused workout tracker for the 3-day barbell program. 
        Build strength sustainably with progressive overload tracking.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <.link href={~p"/users/register"} class="bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-bold px-8 py-4 rounded-xl text-lg transition-all transform hover:scale-105">
          Get Started Free
        </.link>
        <.link href={~p"/users/log-in"} class="bg-slate-700 hover:bg-slate-600 text-white font-medium px-8 py-4 rounded-xl text-lg transition-colors">
          Sign In
        </.link>
      </div>
    </div>

    <!-- Feature Cards -->
    <div class="grid md:grid-cols-3 gap-6 mb-16">
      <div class="bg-slate-800/50 backdrop-blur rounded-2xl p-6 border border-slate-700">
        <div class="w-12 h-12 bg-emerald-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Pre-Built Program</h3>
        <p class="text-slate-400 text-sm">
          The proven A/B split with big compound lifts. Squat, bench, deadlift, OHP, and rows.
        </p>
      </div>

      <div class="bg-slate-800/50 backdrop-blur rounded-2xl p-6 border border-slate-700">
        <div class="w-12 h-12 bg-amber-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Track Progress</h3>
        <p class="text-slate-400 text-sm">
          Log weights, reps, and RPE. See suggested weights based on your last session.
        </p>
      </div>

      <div class="bg-slate-800/50 backdrop-blur rounded-2xl p-6 border border-slate-700">
        <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Rest Timer</h3>
        <p class="text-slate-400 text-sm">
          Built-in rest timer to keep your workout on track. 2-3 min for compounds, 90s for accessories.
        </p>
      </div>
    </div>

    <!-- Workout Preview -->
    <div class="bg-slate-800/30 backdrop-blur rounded-2xl p-6 border border-slate-700 mb-16">
      <h2 class="text-xl font-bold text-white mb-4 text-center">The Program</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-slate-700/30 rounded-xl p-4">
          <h3 class="text-emerald-400 font-semibold mb-3">Workout A</h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li class="flex justify-between">
              <span>Barbell Squat</span>
              <span class="text-slate-500">3×5</span>
            </li>
            <li class="flex justify-between">
              <span>Barbell Bench Press</span>
              <span class="text-slate-500">3×5</span>
            </li>
            <li class="flex justify-between">
              <span>Barbell Row</span>
              <span class="text-slate-500">3×8</span>
            </li>
            <li class="flex justify-between">
              <span>Face Pulls</span>
              <span class="text-slate-500">3×15</span>
            </li>
          </ul>
        </div>
        <div class="bg-slate-700/30 rounded-xl p-4">
          <h3 class="text-amber-400 font-semibold mb-3">Workout B</h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li class="flex justify-between">
              <span>Barbell Overhead Press</span>
              <span class="text-slate-500">3×5</span>
            </li>
            <li class="flex justify-between">
              <span>Barbell Deadlift</span>
              <span class="text-slate-500">3×5</span>
            </li>
            <li class="flex justify-between">
              <span>Close Grip Bench</span>
              <span class="text-slate-500">3×8</span>
            </li>
            <li class="flex justify-between">
              <span>Dumbbell Lunges</span>
              <span class="text-slate-500">3×10</span>
            </li>
          </ul>
        </div>
      </div>
      <p class="text-center text-slate-500 text-sm mt-4">
        Alternate A/B across 3 days per week for balanced, sustainable strength gains.
      </p>
    </div>

    <!-- Self-Hosted Badge -->
    <div class="text-center">
      <div class="inline-flex items-center gap-2 bg-slate-800/50 rounded-full px-4 py-2 border border-slate-700">
        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
        </svg>
        <span class="text-slate-400 text-sm">Self-hosted • Your data, your server</span>
      </div>
    </div>
  </div>
</div>
