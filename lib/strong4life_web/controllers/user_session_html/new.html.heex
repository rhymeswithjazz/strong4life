<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-md">
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <img src="/images/stronk-logo.svg" alt="Stronk" class="h-20" />
      </div>
      <p class="text-slate-300 text-lg">Get stronk with progressive overload</p>
    </div>
    
<!-- Flash Messages -->
    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div class="bg-emerald-500/20 border border-emerald-500/50 rounded-xl p-4 mb-6">
        <p class="text-emerald-400">{Phoenix.Flash.get(@flash, :info)}</p>
      </div>
    <% end %>
    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div class="bg-red-500/20 border border-red-500/50 rounded-xl p-4 mb-6">
        <p class="text-red-400">{Phoenix.Flash.get(@flash, :error)}</p>
      </div>
    <% end %>
    
<!-- Login Card -->
    <div class="bg-slate-800/50 backdrop-blur rounded-2xl border border-slate-700 p-6">
      <h2 class="text-2xl font-bold text-white mb-2 text-center">Welcome Back</h2>
      <p class="text-slate-400 text-center mb-6">
        <%= if @current_scope do %>
          Please reauthenticate to continue.
        <% else %>
          Sign in to continue your training journey.
        <% end %>
      </p>
      
<!-- Dev mode mail adapter notice -->
      <%= if local_mail_adapter?() do %>
        <div class="bg-blue-500/20 border border-blue-500/50 rounded-xl p-4 mb-6">
          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <div class="text-sm">
              <p class="text-blue-300">Development mode: Using local mail adapter.</p>
              <p class="text-blue-400/70">
                View sent emails at
                <.link href="/dev/mailbox" class="underline hover:text-blue-300">
                  /dev/mailbox
                </.link>
              </p>
            </div>
          </div>
        </div>
      <% end %>
      
<!-- Magic Link Login -->
      <.form
        :let={f}
        for={@form}
        as={:user}
        id="login_form_magic"
        action={~p"/users/log-in"}
        class="mb-6"
      >
        <div class="mb-4">
          <label for={f[:email].id} class="block text-sm font-medium text-slate-300 mb-2">
            Email Address
          </label>
          <input
            type="email"
            id={f[:email].id <> "_magic"}
            name={f[:email].name}
            value={f[:email].value}
            readonly={!!@current_scope}
            autocomplete="email"
            required
            class={[
              "w-full bg-slate-700/50 border border-slate-600 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all",
              @current_scope && "opacity-50 cursor-not-allowed"
            ]}
            placeholder="you@example.com"
            phx-mounted={Phoenix.LiveView.JS.focus()}
          />
        </div>

        <button
          type="submit"
          class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold py-3 rounded-xl transition-all transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            />
          </svg>
          Send Magic Link
        </button>
      </.form>
      
<!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-700"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-slate-800/50 text-slate-500">or sign in with password</span>
        </div>
      </div>
      
<!-- Password Login -->
      <.form
        :let={f}
        for={@form}
        as={:user}
        id="login_form_password"
        action={~p"/users/log-in"}
        class="space-y-4"
      >
        <div>
          <label
            for={f[:email].id <> "_password"}
            class="block text-sm font-medium text-slate-300 mb-2"
          >
            Email Address
          </label>
          <input
            type="email"
            id={f[:email].id <> "_password"}
            name={f[:email].name}
            value={f[:email].value}
            readonly={!!@current_scope}
            autocomplete="email"
            required
            class={[
              "w-full bg-slate-700/50 border border-slate-600 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all",
              @current_scope && "opacity-50 cursor-not-allowed"
            ]}
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label for={f[:password].id} class="block text-sm font-medium text-slate-300 mb-2">
            Password
          </label>
          <input
            type="password"
            id={f[:password].id}
            name={f[:password].name}
            autocomplete="current-password"
            class="w-full bg-slate-700/50 border border-slate-600 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all"
            placeholder="Enter your password"
          />
        </div>

        <button
          type="submit"
          name={@form[:remember_me].name}
          value="true"
          class="w-full bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold py-3 rounded-xl transition-all transform hover:scale-[1.02] active:scale-[0.98]"
        >
          Sign In & Remember Me
        </button>

        <button
          type="submit"
          class="w-full bg-slate-700 hover:bg-slate-600 text-white font-medium py-3 rounded-xl transition-all border border-slate-600"
        >
          Sign In Once
        </button>
      </.form>
    </div>
    
<!-- Register Link -->
    <%= unless @current_scope do %>
      <p class="text-center text-slate-400 mt-6">
        Don't have an account?
        <.link
          navigate={~p"/users/register"}
          class="text-emerald-400 hover:text-emerald-300 font-semibold"
        >
          Create one now
        </.link>
      </p>
    <% end %>
  </div>
</div>
