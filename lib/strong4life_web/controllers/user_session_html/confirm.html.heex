<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-md">
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <img src="/images/stronk-logo.svg" alt="Stronk" class="h-20" />
      </div>
      <p class="text-slate-300 text-lg">Get stronk with progressive overload</p>
    </div>
    
<!-- Flash Messages -->
    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div class="bg-emerald-500/20 border border-emerald-500/50 rounded-xl p-4 mb-6">
        <p class="text-emerald-400">{Phoenix.Flash.get(@flash, :info)}</p>
      </div>
    <% end %>
    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div class="bg-red-500/20 border border-red-500/50 rounded-xl p-4 mb-6">
        <p class="text-red-400">{Phoenix.Flash.get(@flash, :error)}</p>
      </div>
    <% end %>
    
<!-- Confirmation Card -->
    <div class="bg-slate-800/50 backdrop-blur rounded-2xl border border-slate-700 p-6">
      <!-- Welcome Icon -->
      <div class="flex justify-center mb-4">
        <div class="w-16 h-16 bg-emerald-500/20 rounded-full flex items-center justify-center">
          <svg
            class="w-8 h-8 text-emerald-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-white mb-2 text-center">
        Welcome, {@user.email}!
      </h2>
      <p class="text-slate-400 text-center mb-6">
        <%= if @user.confirmed_at do %>
          Your account is verified. Choose how to continue:
        <% else %>
          Confirm your account to start training.
        <% end %>
      </p>

      <%= if !@user.confirmed_at do %>
        <.form
          for={@form}
          id="confirmation_form"
          action={~p"/users/log-in?_action=confirmed"}
          phx-mounted={Phoenix.LiveView.JS.focus_first()}
          class="space-y-3"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

          <button
            type="submit"
            name={@form[:remember_me].name}
            value="true"
            class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold py-3 rounded-xl transition-all transform hover:scale-[1.02] active:scale-[0.98]"
          >
            Confirm & Stay Logged In
          </button>

          <button
            type="submit"
            class="w-full bg-slate-700 hover:bg-slate-600 text-white font-medium py-3 rounded-xl transition-all border border-slate-600"
          >
            Confirm & Log In Once
          </button>
        </.form>
        
<!-- Tip -->
        <div class="mt-6 pt-6 border-t border-slate-700">
          <div class="flex items-start gap-3 text-sm">
            <svg
              class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <p class="text-slate-400">
              <span class="text-amber-400 font-medium">Tip:</span>
              You can enable password login in your account settings.
            </p>
          </div>
        </div>
      <% else %>
        <.form
          for={@form}
          id="login_form"
          action={~p"/users/log-in"}
          phx-mounted={Phoenix.LiveView.JS.focus_first()}
          class="space-y-3"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

          <%= if @current_scope do %>
            <button
              type="submit"
              class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold py-3 rounded-xl transition-all transform hover:scale-[1.02] active:scale-[0.98]"
            >
              Continue to Dashboard
            </button>
          <% else %>
            <button
              type="submit"
              name={@form[:remember_me].name}
              value="true"
              class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold py-3 rounded-xl transition-all transform hover:scale-[1.02] active:scale-[0.98]"
            >
              Stay Logged In
            </button>

            <button
              type="submit"
              class="w-full bg-slate-700 hover:bg-slate-600 text-white font-medium py-3 rounded-xl transition-all border border-slate-600"
            >
              Log In Once
            </button>
          <% end %>
        </.form>
      <% end %>
    </div>
  </div>
</div>
